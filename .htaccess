# ---------------------------------------------------------------------------
# Web server rules for dailyutilityapps.store (Apache / LiteSpeed shared
# hosting), uploaded by .github/workflows/ftp.yml. Jekyll copies
# .htaccess into _site by default; GitHub Pages ignores it.
# STATUS.md section 5w.
# ---------------------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.html
# Not-found responses. The page is written out here rather than pointing
# at /404.html: on this host Apache's internal fetch of an error page is
# mapped to a different folder, so "ErrorDocument 404 /404.html" failed
# with "Additionally, a 404 Not Found error was encountered" (11 Oct).
# The status stays 404; browsers then swap in the site's full 404 page
# (served at /404). Must stay on one line, with no double quotes inside.
ErrorDocument 404 "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='robots' content='noindex'><title>Page not found | Daily Utility Apps</title><style>:root{color-scheme:light dark}body{margin:0;padding:18vh 24px;font:17px/1.6 system-ui,sans-serif;text-align:center;background:Canvas;color:CanvasText}h1{margin:0 0 .5rem;font-size:2rem}a{color:LinkText}</style></head><body><h1>Page not found</h1><p>The page you were looking for isn't here.</p><p><a href='/'>Homepage</a> &middot; <a href='/daily-info/'>Daily Info</a> &middot; <a href='/contact'>Contact</a></p><script>fetch('/404').then(function(r){return r.ok?r.text():null}).then(function(h){if(h){document.open();document.write(h);document.close()}}).catch(function(){})</script></body></html>"

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for every page: https, no www.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Clean URLs. Jekyll writes about.html but every link and canonical is
  # /about. A typed or old /about.html redirects to /about (and
  # /daily-info/index.html to /daily-info/), then /about is answered from
  # about.html. THE_REQUEST is the browser's own request line, so the
  # internal rewrite below never loops back into these redirects.
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[\s?]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Stylesheets and scripts carry a ?v= stamp that changes on every build,
# so browsers may keep them for a year. Pages are always rechecked.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript text/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
